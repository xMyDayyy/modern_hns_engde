gPikachuIntro_Text_Page1::
#if GERMAN
	.string "Die Welt, in die du jetzt gelangst, wird\n"
	.string "dir ein Abenteuer bescheren, in dem du\l"
	.string "der Held bist.\l"
	.string "Rede mit den Leuten und überprüfe\l"
	.string "Dinge, wo immer du bist, in Städten, auf\l"
	.string "Straßen oder in Höhlen. Sammle überall\l"
	.string "Informationen.$"
#else
	.string "In the world which you are about to\n"
	.string "enter, you will embark on a grand\n"
	.string "adventure with you as the hero.\n"
	.string "\n"
	.string "Speak to people and check things\n"
	.string "wherever you go, be it towns, roads,\n"
	.string "or caves. Gather information and\n"
	.string "hints from every source.$"
#endif

gPikachuIntro_Text_Page2::
#if GERMAN
	.string "Neue Wege werden sich auftun, indem du\n"
	.string "Menschen in Not hilfst,\l"
	.string "Herausforderungen meisterst und\l"
	.string "Rätsel löst.\l"
	.string "Manchmal wirst du von anderen\l"
	.string "herausgefordert und von wilden\l"
	.string "Geschöpfen angegriffen. Sei tapfer und\l"
	.string "lass dich nicht beirren!$"
#else
	.string "New paths will open to you by helping\n"
	.string "people in need, overcoming challenges,\n"
	.string "and solving mysteries.\n"
	.string "\n"
	.string "At times, you will be challenged by\n"
	.string "others and attacked by wild creatures.\n"
	.string "Be brave and keep pushing on.$"
#endif

gPikachuIntro_Text_Page3::
#if GERMAN
	.string "Während deines Abenteuers\n"
	.string "interagierst du hoffentlich mit allen\l"
	.string "möglichen Personen, um deinen\l"
	.string "Charakter zu festigen.\l"
	.string "Das ist unser Hauptziel.\l"
	.string "Drücke den A-Knopf, um das Abenteuer\l"
	.string "zu beginnen!$"
#else
	.string "Through your adventure, we hope\n"
	.string "that you will interact with all sorts\n"
	.string "of people and achieve personal growth.\n"
	.string "That is our biggest objective.\n"
	.string "\n"
	.string "Press the A Button, and let your\n"
	.string "adventure begin!$"
#endif

gOakSpeech_Text_WelcomeToTheWorld::
#if GERMAN
	.string "Hallo!\p"
	.string "Herzlich willkommen in der Welt der\n"
